# Copier en .env et adapter. Les variables sont lues par voicechat.config.
# (Aucun secret ici : llama.cpp ignore Authorization par défaut.)

# Serveur LLM OpenAI-compatible
VOICECHAT_BASE_URL=http://100.91.114.49:8080/v1
# Laisser vide = détection auto via /v1/models
VOICECHAT_MODEL=
VOICECHAT_API_KEY=

# Voix Kokoro : ff_siwis = français féminin
# Mélange pondéré possible (Kokoro n'a qu'une voix française) :
#   ff_siwis,ef_dora          -> moitié-moitié
#   ff_siwis:3+ef_dora:1      -> 75 % / 25 %   (cf. README §11)
VOICECHAT_VOICE=ff_siwis
VOICECHAT_LANG=f
VOICECHAT_SPEED=1.0

# auto | cuda | cpu
VOICECHAT_DEVICE=auto

# 1 = voix active, 0 = chat muet
VOICECHAT_TTS=1

# Prompt système
VOICECHAT_SYSTEM=Tu es un assistant francophone concis et précis. Réponds en phrases courtes, sans listes à puces.

# Conversations sauvegardées et profils de prompt
VOICECHAT_DATA=~/.local/share/voicechat
VOICECHAT_PROFILS=~/.config/voicechat/profils
# Profil de prompt système à charger au démarrage (vide = aucun)
VOICECHAT_PROFIL=

# --- Entrée vocale (v0.4, expérimental — lire le README §10 avant de s'en servir) ---
# 1 = démarrer en mains libres : le micro remplace le clavier
VOICECHAT_MICRO=0
# base | small | medium | large-v3   (small = bon compromis mesuré sur la GTX 1050)
VOICECHAT_STT_MODELE=small
# auto | cuda | cpu
VOICECHAT_STT_DEVICE=auto
# Langue forcée. Laisser vide = détection automatique par Whisper.
VOICECHAT_STT_LANGUE=fr
# Périphérique d'entrée (nom ou index). Vide = défaut du système, qui peut être
# le « monitor » des haut-parleurs et non le micro : voir README §10.
VOICECHAT_MICRO_DEVICE=
