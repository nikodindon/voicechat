# Copier en .env et adapter. Les variables sont lues par voicechat.config.
# (Aucun secret ici : llama.cpp ignore Authorization par défaut.)

# Serveur LLM OpenAI-compatible
VOICECHAT_BASE_URL=http://100.91.114.49:8080/v1
# Laisser vide = détection auto via /v1/models
VOICECHAT_MODEL=
VOICECHAT_API_KEY=

# Voix Kokoro : ff_siwis = français féminin
VOICECHAT_VOICE=ff_siwis
VOICECHAT_LANG=f
VOICECHAT_SPEED=1.0

# auto | cuda | cpu
VOICECHAT_DEVICE=auto

# 1 = voix active, 0 = chat muet
VOICECHAT_TTS=1

# Prompt système
VOICECHAT_SYSTEM=Tu es un assistant francophone concis et précis. Réponds en phrases courtes, sans listes à puces.
