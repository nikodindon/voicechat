# Copier en .env et adapter. Les variables sont lues par voicechat.config.
# (Aucun secret ici : llama.cpp ignore Authorization par défaut.)

# Serveur LLM OpenAI-compatible
VOICECHAT_BASE_URL=http://100.91.114.49:8080/v1
# Serveurs de secours, séparés par des virgules, essayés dans l'ordre si le
# principal ne répond pas (cf. README §12)
VOICECHAT_SECOURS=
# Laisser vide = détection auto via /v1/models
VOICECHAT_MODEL=
VOICECHAT_API_KEY=

# Voix Kokoro : ff_siwis = français féminin
# Mélange pondéré possible (Kokoro n'a qu'une voix française) :
#   ff_siwis,ef_dora          -> moitié-moitié
#   ff_siwis:3+ef_dora:1      -> 75 % / 25 %   (cf. README §11)
VOICECHAT_VOICE=ff_siwis
VOICECHAT_LANG=f
VOICECHAT_SPEED=1.0

# auto | cuda | cpu
VOICECHAT_DEVICE=auto

# 1 = voix active, 0 = chat muet
VOICECHAT_TTS=1

# Prompt système
VOICECHAT_SYSTEM=Tu es un assistant francophone concis et précis. Réponds en phrases courtes, sans listes à puces.

# Conversations sauvegardées et profils de prompt
VOICECHAT_DATA=~/.local/share/voicechat
VOICECHAT_PROFILS=~/.config/voicechat/profils
# Profil de prompt système à charger au démarrage (vide = aucun)
VOICECHAT_PROFIL=

# --- Entrée vocale (v0.4, expérimental — lire le README §10 avant de s'en servir) ---
# 1 = démarrer en mains libres : le micro remplace le clavier
VOICECHAT_MICRO=0
# base | small | medium | large-v3   (small = bon compromis mesuré sur la GTX 1050)
VOICECHAT_STT_MODELE=small
# auto | cuda | cpu
VOICECHAT_STT_DEVICE=auto
# Langue forcée. Laisser vide = détection automatique par Whisper.
VOICECHAT_STT_LANGUE=fr
# Périphérique d'entrée (nom ou index). Vide = défaut du système, qui peut être
# le « monitor » des haut-parleurs et non le micro : voir README §10.
VOICECHAT_MICRO_DEVICE=

# --- Cache disque et mode distribué (v1.0 — lire le README §13) ---
# 1 = réutiliser l'audio des phrases déjà synthétisées (0 = tout resynthétiser).
# Un LLM se répète beaucoup ; sur cette machine la réserve fait passer une phrase
# répétée de ~280 ms à ~0 ms.
VOICECHAT_CACHE=1
# Où ranger cet audio. Vide = ~/.cache/voicechat/tts
VOICECHAT_CACHE_DIR=

# Synthèse déportée : envoyer le TEXTE à un service TTS et recevoir l'AUDIO.
# À mettre sur le poste léger (portable sans GPU) ; vide = synthèse locale.
# Le poste qui a le GPU lance, lui :  voicechat --serveur-tts
VOICECHAT_TTS_URL=

# Fichier de configuration TOML. Vide = ~/.config/voicechat/config.toml
VOICECHAT_CONFIG=

# --- Génération (réglables aussi en TOML et en ligne de commande) ---
VOICECHAT_TEMPERATURE=0.7
VOICECHAT_MAX_TOKENS=0
VOICECHAT_TIMEOUT=300

# --- Contexte (v1.2) ---
# Taille du contexte, en tokens. Laisser VIDE (0) = le client la demande au serveur
# via /props, et compte en tokens d'après les chiffres qu'il lui donne.
# Mettre une valeur force le budget — utile si le serveur ne sait pas répondre à
# /props, ou pour éprouver l'élagage avec un petit contexte.
VOICECHAT_N_CTX=0
